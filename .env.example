# TASKORA Environment Configuration Example
# Copy this file to .env and fill in your values.
# The application will run smoothly with fallbacks even if ELEVENLABS_API_KEY is empty.

# ElevenLabs Text-to-Speech API
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Passwordless email OTP authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=your_resend_api_key
SMTP_FROM=TASKORA <no-reply@your-verified-domain.com>
SMTP_USE_TLS=true
# Set true on HTTPS deployments.
COOKIE_SECURE=false
