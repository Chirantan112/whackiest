# TASKORA Environment Configuration Example
# Copy this file to .env and fill in your values.
# The application will run smoothly with fallbacks even if ELEVENLABS_API_KEY is empty.

# ElevenLabs Text-to-Speech API
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Set true when deployed over HTTPS; leave false for local development.
COOKIE_SECURE=false
